{
  "name": "shardmail-backend",
  "version": "1.0.0",
  "description": "ShardMail Cloudflare Worker & D1 Backend",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:create": "wrangler d1 create shardmail-db",
    "d1:migrate:local": "wrangler d1 migrations apply shardmail-db --local",
    "d1:migrate:remote": "wrangler d1 migrations apply shardmail-db --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261120.1",
    "typescript": "^5.4.5",
    "wrangler": "^4.165.0"
  }
}
